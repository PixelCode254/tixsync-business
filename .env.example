# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://tixsyncsolutions.com"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Admin credentials (used for seeding)
ADMIN_EMAIL="admin@tixsyncsolutions.com"
ADMIN_PASSWORD="change-this-password"

# API Security
API_SECRET_KEY="generate-a-random-api-key-here"

# CORS
CORS_ORIGINS="https://tixsyncsolutions.com,https://corneliusmaina.dev"

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="TIXSYNC SOLUTIONS <your-email@gmail.com>"

# Email backup (Resend)
RESEND_API_KEY="re_your_key_here"
RESEND_FROM="TIXSYNC <onboarding@resend.dev>"

# OpenAI (optional — falls back to knowledge base if not set)
# OPENAI_API_KEY="sk-..."

# Contact
CONTACT_EMAIL="info@tixsyncsolutions.com"
